generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_ADMIN
  CUSTOMER
  TRANSPORT_ADMIN
  OPS_ADMIN
  SECURITY
  DRIVER
}

enum BookingStatus {
  BOOKING_PENDING
  BOOKING_COUNTER
  BOOKING_CONFIRMED
  READY_TO_COLLECT
  SECURITY_HOLD
  IN_TRANSIT
  DELIVERED_PENDING_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  HOLD
  REMOVED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleSource {
  MANUAL
  CSV_IMPORT
  EXCEL_IMPORT
}

enum ReadyToCollectSource {
  OPS_MANUAL
  STOCK_IMPORT
}

enum AuditEntityType {
  USER
  CUSTOMER_ACCOUNT
  SITE
  VEHICLE
  BOOKING
  BOOKING_SETTINGS
}

model CustomerAccount {
  id          Int      @id @default(autoincrement())
  companyName String
  contactName String
  email       String   @unique
  phone       String
  address     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  vehicles Vehicle[]
  bookings Booking[]

  @@index([companyName])
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  username          String   @unique
  email             String   @unique
  passwordHash      String
  role              UserRole
  isActive          Boolean  @default(true)
  customerAccountId Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])

  assignedBookings            Booking[] @relation("AssignedDriver")
  createdBookings             Booking[] @relation("CreatedByUser")
  readyMarkedBookings         Booking[] @relation("ReadyMarkedBy")
  dateChangeRequestedBookings Booking[] @relation("DateChangeRequestedBy")
  cancelledBookings           Booking[] @relation("CancelledBy")
  securityVerifiedBookings    Booking[] @relation("SecurityVerifiedDriver")

  auditLogs              AuditLog[]
  bookingSettingsUpdates BookingSettings[]

  @@index([customerAccountId])
}

model Site {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
}

model Vehicle {
  id                Int @id @default(autoincrement())
  siteId            Int
  customerAccountId Int

  vin    String @unique
  reg    String
  make   String
  model  String
  colour String

  fuelType FuelType
  mileage  Int

  registrationDate DateTime
  motExpiryDate    DateTime

  vehicleStatus VehicleStatus @default(AVAILABLE)

  stockStage String?

  source VehicleSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site            Site            @relation(fields: [siteId], references: [id])
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id])

  bookings Booking[]

  @@index([reg])
  @@index([vehicleStatus])
  @@index([stockStage])
  @@index([siteId])
  @@index([customerAccountId])
}

model Booking {
  id Int @id @default(autoincrement())

  vehicleId         Int
  customerAccountId Int

  jobNumber    String @unique
  agreementRef String

  recipientName    String
  recipientEmail   String
  recipientPhone   String
  recipientAddress String

  requestedCollectionDate DateTime
  confirmedCollectionDate DateTime?
  counterProposedDate     DateTime?
  scheduledCollectionDate DateTime

  pendingDateChange           DateTime?
  dateChangeRequestedAt       DateTime?
  dateChangeRequestedByUserId Int?

  status BookingStatus @default(BOOKING_PENDING)

  lastCounteredBy UserRole?

  assignedDriverId Int?
  createdByUserId  Int?

  readyToCollectAt       DateTime?
  readyToCollectSource   ReadyToCollectSource?
  readyToCollectByUserId Int?

  securityDriverVerifiedAt DateTime?
  securityVerifiedDriverId Int?

  driverCollectedAt  DateTime?
  securityReleasedAt DateTime?

  securityHoldReason     String?
  securityHoldAt         DateTime?
  securityHoldResolvedAt DateTime?

  driverDeliveredAt DateTime?

  deliveryConfirmationToken String?   @unique
  deliveryOtpHash           String?
  deliveryOtpExpiresAt      DateTime?
  deliveryOtpAttempts       Int       @default(0)
  deliveryOtpVerifiedAt     DateTime?

  cancelledAt        DateTime?
  cancelledByUserId  Int?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id])

  assignedDriver User? @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  createdByUser  User? @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  readyToCollectByUser User? @relation("ReadyMarkedBy", fields: [readyToCollectByUserId], references: [id])

  dateChangeRequestedByUser User? @relation("DateChangeRequestedBy", fields: [dateChangeRequestedByUserId], references: [id])

  cancelledByUser User? @relation("CancelledBy", fields: [cancelledByUserId], references: [id])

  securityVerifiedDriver User? @relation("SecurityVerifiedDriver", fields: [securityVerifiedDriverId], references: [id])

  @@index([vehicleId])
  @@index([customerAccountId])
  @@index([status])
  @@index([assignedDriverId])
  @@index([scheduledCollectionDate])
  @@index([requestedCollectionDate])
}

model BookingSettings {
  id             Int @id @default(1)
  processingDays Int @default(3)
  dailySlotLimit Int @default(60)
  cutoffHour     Int @default(12)

  updatedByUserId Int?
  updatedAt       DateTime @updatedAt

  updatedByUser User? @relation(fields: [updatedByUserId], references: [id])
}

model AuditLog {
  id         Int             @id @default(autoincrement())
  entityType AuditEntityType
  entityId   Int
  action     String

  fieldName     String?
  previousValue String?
  newValue      String?

  changedByUserId Int?
  changedByRole   UserRole?
  changedByName   String?

  createdAt DateTime @default(now())

  changedByUser User? @relation(fields: [changedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([changedByUserId])
}
